# =============================================================================
# Standalone Research Document Chat & RAG Environment Configuration
# =============================================================================

# Backend Application Settings
# Local-development shortcut only; integrate real auth before production.
RESEARCH_CHAT_ALLOW_DEV_AUTH=true
HOST=localhost
PORT=8087
DATABASE_URL=sqlite:///./research_chat.db

# External Document Management System (DMS) & Vector Store (Weaviate)
RAG_BUILDER_BASE_URL=https://ikm-api.sciagen.ai
RAG_BUILDER_API_PREFIX=/api/v1
RAG_BUILDER_TIMEOUT_SECONDS=600
RAG_BUILDER_USER=digital-msl
RAG_BUILDER_USERNAME=digital-msl
RAG_BUILDER_PASSWORD=your_rag_builder_password_here

# Digital MSL (retina scope, validation engine, channels)
# Comma-separated retina molecules allowed in search and chat scope.
DIGITAL_MSL_MOLECULES=aflibercept,ranibizumab,faricimab
# Overall validation score required before an answer is shown (else routed to Physical MSL).
DIGITAL_MSL_CONFIDENCE_THRESHOLD=0.90
# Every individual claim must also reach this score.
DIGITAL_MSL_CLAIM_MIN_SCORE=0.70
# Use the configured LLM as an entailment judge inside the validation engine.
DIGITAL_MSL_USE_LLM_JUDGE=true
DIGITAL_MSL_DEFAULT_MSL_ID=msl_default
# Pre/post validation JSON files are written here (relative to backend/).
DIGITAL_MSL_TRACE_DIR=logs/validation
# Optional outbound channel providers. When unset, replies are stored in the outbox table.
DIGITAL_MSL_SMTP_HOST=smtp.gmail.com
DIGITAL_MSL_SMTP_PORT=587
DIGITAL_MSL_SMTP_USER=your_email@example.com
DIGITAL_MSL_SMTP_PASSWORD=your_smtp_password_here
DIGITAL_MSL_SMTP_FROM=your_email@example.com
DIGITAL_MSL_WHATSAPP_API_URL=
DIGITAL_MSL_WHATSAPP_TOKEN=

# Research Connectors Configuration
PUBMED_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_EMAIL=researcher@example.com
PUBMED_API_KEY=
CLINICALTRIALS_URL=https://clinicaltrials.gov/api/v2

# LLM Provider Configuration ("azure_openai", "openai", or "anthropic")
LLM_PROVIDER=azure_openai

# Azure OpenAI Credentials (if using azure_openai)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# OpenAI Credentials (if using openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Anthropic Credentials (if using anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Retrieval & Hybrid Search Settings
HYBRID_SEARCH_ALPHA=0.5
DEFAULT_RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3

# Digital MSL security / compliance (see docs/DIGITAL_MSL_PRODUCTION.md)
DIGITAL_MSL_ENVIRONMENT=production
# Demo mode seeds doctor/msl/admin@demo.example. The app refuses to start when this is true and ENVIRONMENT=production.
DIGITAL_MSL_DEMO_MODE=false
DIGITAL_MSL_ALLOW_UNREGISTERED_SENDERS=false
DIGITAL_MSL_REQUIRE_VERIFIED_DOCTOR=true
DIGITAL_MSL_REQUIRE_ADMIN_MFA=true
DIGITAL_MSL_PASSWORD_MIN_LENGTH=12
DIGITAL_MSL_HIBP_CHECK=false
DIGITAL_MSL_SESSION_TTL_HOURS=12
DIGITAL_MSL_SESSION_IDLE_MINUTES=30
DIGITAL_MSL_COOKIE_SECURE=true
DIGITAL_MSL_MAX_FAILED_LOGINS=5
DIGITAL_MSL_LOCKOUT_MINUTES=15
DIGITAL_MSL_AUTH_RATE_LIMIT_PER_MINUTE=10
DIGITAL_MSL_RATE_LIMIT_PER_MINUTE=12
# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"). Back it up.
DIGITAL_MSL_DATA_KEY=
DIGITAL_MSL_INBOUND_SECRET=
DIGITAL_MSL_WHATSAPP_APP_SECRET=
# Registration contact verification. DEV_ECHO_OTP returns OTPs in the API response: local development only.
DIGITAL_MSL_DEV_ECHO_OTP=false
DIGITAL_MSL_WHATSAPP_OTP_TEMPLATE=
DIGITAL_MSL_NMR_ID_REQUIRED=false
DIGITAL_MSL_CLAMAV_HOST=
DIGITAL_MSL_CLAMAV_PORT=3310
# Compliance notice
DIGITAL_MSL_PV_CONTACT=[PHARMACOVIGILANCE CONTACT]
DIGITAL_MSL_PUBLIC_BASE_URL=https://dmsl.example.com
